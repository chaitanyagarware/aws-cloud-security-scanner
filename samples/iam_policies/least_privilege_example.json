{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadSpecificSecurityLogs",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::company-security-logs",
        "arn:aws:s3:::company-security-logs/cloudtrail/*"
      ],
      "Condition": {
        "Bool": {
          "aws:MultiFactorAuthPresent": "true"
        }
      }
    }
  ]
}
